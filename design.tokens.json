{
  "$comment": "Single source of truth for look and format. Read by video.config.mjs (Node) and remotion/src/theme.ts (TypeScript). Change it here and both the ffmpeg pipeline and the Remotion compositions follow. Brand stops sampled from the RE-DOMS mark: orange #ec8c22, teal #1294bd, red #d62430.",

  "video": {
    "width": 1600,
    "height": 900,
    "fps": 30
  },

  "fonts": {
    "display": "Michroma",
    "displayWeights": ["400"],
    "sans": "Geist",
    "sansWeights": ["400", "600"],
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },

  "color": {
    "page": "#f2f2f2",
    "container": "#ffffff",
    "raised": "#fafafa",

    "text": "#101010",
    "secondary": "#464646",
    "tertiary": "#737373",

    "muted": "rgba(0,0,0,0.08)",
    "stroke": "rgba(0,0,0,0.14)",

    "brand": "#ec8c22",
    "brandLight": "#f7ab52",
    "brandDeep": "#c96a10",
    "brandSoft": "#fff5e9",

    "accent": "#1294bd",
    "accentSoft": "rgba(18,148,189,0.12)",

    "success": "#1e9e6a",
    "successSoft": "rgba(30,158,106,0.12)",
    "error": "#d62430",
    "errorSoft": "#fff1f2"
  },

  "cursor": {
    "fill": "#ffffff",
    "stroke": "#111111",
    "ripple": "rgba(236,140,34,0.9)",
    "size": 22
  },

  "avatar": {
    "$comment": "The Wayam AI avatar. Gradient stops sampled from assets/Logo Main.svg (the Wayam mark), light to deep; ink is the wordmark colour.",
    "gradient": ["#FFA12B", "#FA8D23", "#F0731A", "#DC440C"],
    "ink": "#161C26",
    "eye": "#FFFFFF"
  }
}
