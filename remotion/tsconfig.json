{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "paths": {
      "remotion": [
        "./engine/runtime.tsx"
      ],
      "@local": [
        "./src/local.tsx",
        "./src/local.example.tsx"
      ]
    }
  },
  "include": [
    "src",
    "engine",
    "../design.tokens.json"
  ]
}
