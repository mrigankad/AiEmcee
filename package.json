{
  "name": "@mrigankad/aiemcee",
  "version": "1.0.0",
  "type": "module",
  "description": "Narrated product demo videos, generated end to end: Edge TTS narration, Playwright screen capture, Remotion motion graphics, ffmpeg assembly.",
  "license": "MIT",
  "homepage": "https://github.com/mrigankad/AiEmcee#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrigankad/AiEmcee.git"
  },
  "bugs": {
    "url": "https://github.com/mrigankad/AiEmcee/issues"
  },
  "keywords": [
    "video-generation",
    "demo-video",
    "product-demo",
    "screencast",
    "remotion",
    "playwright",
    "ffmpeg",
    "edge-tts",
    "text-to-speech",
    "motion-graphics",
    "screen-recording"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "aiemcee": "bin/aiemcee.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "bin",
    "scripts",
    "remotion",
    "!remotion/out",
    "!remotion/node_modules",
    "!remotion/public/film",
    ".claude/skills",
    "docs",
    "examples",
    "assets",
    "design.tokens.json",
    "narration.json",
    "scenes.mjs",
    "video.config.mjs"
  ],
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "validate": "node scripts/validate.mjs",
    "narrate": "node scripts/narrate.mjs",
    "motion": "node remotion/render.mjs",
    "capture": "node scripts/capture.mjs",
    "clip": "node scripts/clip.mjs",
    "compose": "node scripts/compose.mjs",
    "build": "npm run narrate && npm run clip && npm run capture && npm run compose",
    "studio": "npm --prefix remotion run studio",
    "setup": "npm install && npm --prefix remotion install && npx playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  }
}
