{
  "name": "@mrigankad/aiemcee",
  "version": "1.2.0",
  "type": "module",
  "description": "Narrated product demo videos, generated end to end: Edge TTS narration, Playwright screen capture, Remotion motion graphics, ffmpeg assembly.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/mrigankad/AiEmcee#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrigankad/AiEmcee.git"
  },
  "bugs": {
    "url": "https://github.com/mrigankad/AiEmcee/issues"
  },
  "keywords": [
    "video-generation",
    "demo-video",
    "product-demo",
    "screencast",
    "playwright",
    "ffmpeg",
    "edge-tts",
    "text-to-speech",
    "motion-graphics",
    "screen-recording"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "aiemcee": "bin/aiemcee.mjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "bin",
    "scripts",
    "studio",
    "remotion",
    "!remotion/out",
    "!remotion/node_modules",
    "!remotion/public/film",
    "!remotion/public/projects",
    ".claude/skills",
    "docs",
    "examples",
    "assets",
    "design.tokens.json",
    "narration.json",
    "scenes.mjs",
    "video.config.mjs",
    "NOTICE",
    "projects/_template",
    "!remotion/src/local.tsx",
    "!remotion/src/compositions/*/",
    "!remotion/public/*",
    "remotion/public/README.md",
    "remotion/public/mark.svg",
    "!assets/*.mp4",
    "!assets/*.mov",
    "!assets/*.mp3",
    "!assets/*.wav",
    "!assets/music",
    "!docs/media/preview.gif"
  ],
  "scripts": {
    "doctor": "node bin/aiemcee.mjs doctor",
    "validate": "node bin/aiemcee.mjs validate",
    "narrate": "node bin/aiemcee.mjs narrate",
    "motion": "node remotion/render.mjs",
    "capture": "node bin/aiemcee.mjs capture",
    "clip": "node bin/aiemcee.mjs clip",
    "compose": "node bin/aiemcee.mjs compose",
    "build": "npm run narrate && npm run clip && npm run capture && npm run compose",
    "studio": "node scripts/motion-studio.mjs",
    "setup": "npm ci && npm --prefix remotion ci && npx playwright install chromium",
    "film": "node bin/aiemcee.mjs film",
    "web": "node bin/aiemcee.mjs studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "playwright": "1.62.1"
  }
}
